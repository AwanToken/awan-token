# Ton network: testnet | mainnet
VITE_NETWORK=testnet

# AwanToken minter (jetton master) — current testnet
VITE_MINTER=EQB6KK-nxduKxw54eQR4YPvStIUFA_tTjqVs8emrl3KC3Vys

# CORS-friendly TonAPI REST (preferred in browser — avoids toncenter 429/CORS)
VITE_TONAPI=https://testnet.tonapi.io/v2

# JSON-RPC fallback for TonClient
VITE_RPC=https://testnet.toncenter.com/api/v2/jsonRPC

# Treasury / keeper address receiving upgrade shop TON payments
VITE_TREASURY_OR_KEEPER=UQCKBs_vJoZzhIrcz46G4KieMA1xRPTA7ALT0KOnz-PhRou6

# Ston.fi swap deep-links (primary Buy/Sell CTAs)
# VITE_STON_FI_BUY_URL=https://app.ston.fi/swap?ft=TON&tt=<MINTER>
# VITE_STON_FI_SELL_URL=https://app.ston.fi/swap?ft=<MINTER>&tt=TON

# DeDust pool address (buy-limit reserve quotes only)
# VITE_DEDUST_POOL=

# Absolute URL to tonconnect-manifest.json (set automatically by npm run tunnel)
# VITE_MANIFEST_URL=https://your-tunnel.example/tonconnect-manifest.json
