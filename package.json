{
  "name": "awann-token",
  "version": "1.0.0",
  "private": true,
  "description": "$AWN (AwanToken) Jetton smart contracts for TON — Tact",
  "scripts": {
    "build": "tact --config tact.config.json",
    "build:clean": "rimraf build && tact --config tact.config.json",
    "deploy:testnet": "tsx scripts/deployTestnet.ts",
    "deploy:mainnet": "tsx scripts/deployMainnet.ts",
    "deploy:mainnet:wait": "tsx scripts/waitAndDeployMainnet.ts",
    "ops:postdeploy:testnet": "tsx scripts/postDeployTestnet.ts",
    "ops:postdeploy:mainnet": "tsx scripts/postDeployMainnet.ts",
    "setup:pool:testnet": "tsx scripts/setupPoolTestnet.ts",
    "setup:pool:mainnet": "tsx scripts/setupPoolMainnet.ts",
    "check:mainnet-wallet": "tsx scripts/checkMainnetWallet.ts",
    "test:trade:testnet": "tsx scripts/testTradeTestnet.ts",
    "test:sell-claim:testnet": "tsx scripts/testSellClaimTestnet.ts",
    "sweep:tax:testnet": "tsx scripts/sweepTaxTestnet.ts",
    "read:testnet": "tsx scripts/readMinter.ts",
    "admin": "npm run dev --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "miniapp": "npm run dev --prefix miniapp",
    "miniapp:build": "npm run build --prefix miniapp",
    "miniapp:tunnel": "npm run tunnel --prefix miniapp",
    "miniapp:go-live": "npm run go-live --prefix miniapp"
  },

  "dependencies": {
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.2.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@tact-lang/compiler": "^1.6.7",
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
