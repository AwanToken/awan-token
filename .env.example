# Owner seed — LOCAL ONLY (never commit, never paste in chat/Netlify/docs)
# 24 words, space-separated. Keep this file as .env (gitignored).
WALLET_MNEMONIC="word1 word2 word3 ... word24"

# Optional: separate mainnet Owner seed (preferred if different from testnet)
# WALLET_MNEMONIC_MAINNET="word1 word2 ... word24"

# Optional but recommended (https://testnet.toncenter.com)
TONCENTER_API_KEY=

# Optional overrides for on-chain metadata at deploy
JETTON_NAME=AwanToken
JETTON_SYMBOL=AWN
JETTON_DESCRIPTION=AwanToken ($AWN) — TON jetton with DEX limits, sell-tax treasury and weekly GRAM claims.
JETTON_DECIMALS=9
JETTON_IMAGE=https://awantoken.netlify.app/awn-logo.png

# Used by npm run read:testnet if set (else deployments/testnet.json)
MINTER_ADDRESS=
